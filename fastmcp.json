{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "path": "mcp-server/server.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.12",
    "dependencies": [
      "fastmcp>=4.1.6",
      "mcp>=2.3.0"
    ]
  },
  "deployment": {
    "transport": "stdio",
    "log_level": "WARNING"
  }
}
