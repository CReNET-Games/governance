{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Crenet Games Asset Provenance Ledger",
  "description": "Tracks provenance recipes (1 to 6 steps) and AI involvement across binary visual/audio game assets and Tier 1 workspace artifacts.",
  "type": "object",
  "required": ["version", "assets"],
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "const": 2
    },
    "assets": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/definitions/assetEntry"
      }
    }
  },
  "definitions": {
    "assetEntry": {
      "type": "object",
      "required": ["asset_path", "status", "ai_involvement", "steps", "logged_at"],
      "additionalProperties": false,
      "properties": {
        "asset_path": {
          "type": "string",
          "minLength": 1,
          "description": "Repository-relative POSIX path to the canonical asset or Tier 1 artifact."
        },
        "previous_paths": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true,
          "description": "Former repository-relative paths prior to graduation from artifacts/ or file moves."
        },
        "status": {
          "type": "string",
          "enum": ["active", "deprecated"]
        },
        "ai_involvement": {
          "type": "string",
          "enum": ["none", "assisted", "generated"],
          "description": "Derived from steps: 'none' (no ai steps), 'generated' (all ai steps), 'assisted' (mixed)."
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$",
          "description": "Lowercase hex SHA-256 digest of the asset file when last logged or verified on disk."
        },
        "notes": {
          "type": "string",
          "description": "Optional studio context, licensing notes, or audit annotations."
        },
        "logged_at": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 UTC timestamp when this asset entry was first created."
        },
        "updated_at": {
          "type": "string",
          "minLength": 1,
          "description": "ISO-8601 UTC timestamp when this asset entry was last updated or moved."
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": {
            "$ref": "#/definitions/provenanceStep"
          }
        }
      }
    },
    "provenanceStep": {
      "type": "object",
      "required": ["actor", "tool", "summary"],
      "additionalProperties": false,
      "properties": {
        "actor": {
          "type": "string",
          "enum": ["human", "ai", "procedural"]
        },
        "tool": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "prompt": {
          "type": "string",
          "minLength": 1
        },
        "artifact_ref": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "seed": {
          "type": ["string", "integer"]
        },
        "license": {
          "type": "string",
          "minLength": 1
        }
      },
      "if": {
        "properties": {
          "actor": { "const": "ai" }
        },
        "required": ["actor"]
      },
      "then": {
        "required": ["prompt"]
      },
      "else": {
        "not": {
          "required": ["prompt"]
        }
      }
    }
  }
}
